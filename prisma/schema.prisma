// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id String @id @default(cuid())
  email String? @unique
  emailVerified DateTime?
  name String?
  image String?
  password String?
  username String? @unique
  createdAt DateTime @default(now())
  steam_trade_url String?
  steam_id String?
  steamApiKey String?
  cash Float @default(0)
  lastInventoryRefresh DateTime @default("1970-01-01T00:00:00Z")
  twoFactorCode String?
  twoFactorExpires DateTime?

  accounts account[]
  sessions session[]
  listings item_listing[]
  inventory_item inventory_item[]
  purchases_as_buyer  purchase[] @relation("buyer_purchases")
  purchases_as_seller purchase[] @relation("seller_purchases")
  buy_orders buy_order[]
}

model inventory_item {
  id String @id @default(cuid())
  userId String
  assetId String @unique
  market_name String
  market_hash_name String
  icon String
  type String
  hexColor String
  game String
  commodity Boolean @default(false)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model pendingAccount {
  id String @id @default(cuid())
  email String @unique
  username String @unique
  password String
  token String @unique
  expires DateTime
}

model resetPassword {
  id String @id @default(cuid())
  token String @unique
  email String @unique
  expires DateTime
}

model session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model verificationToken {
  identifier String
  token String @unique
  expires DateTime

  @@unique([identifier, token])
}

model crypto_deposit {
  id        String   @id @default(cuid())
  userId    String
  address   String   @unique
  index     Int      @unique
  amountUsdc Float
  status    String   @default("pending") // pending | confirmed | swept | expired
  txHash    String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model deposit_counter {
  id        String @id
  value     Int    @default(0)
  lastBlock BigInt @default(0)
}

model item {
  marketName     String   @id
  marketHashName String
  price          Float
  game           String
  updatedAt      DateTime @default(now()) @updatedAt
}

model item_float {
  assetId    String   @id
  floatValue Float?
  paintSeed  Int?
  stickers   Json?
  fetchedAt  DateTime @default(now())
}

model item_listing {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  userId String
  assetId String @unique  // Steam asset ID - unique per item instance
  marketName String
  price Float
  game String?
  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model buy_order {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userId     String
  marketName String
  price      Float
  quantity   Int
  game       String?
  icon       String?
  hexColor   String?
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model purchase {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  // pending | offer_sent | completed | cancelled
  status        String   @default("pending")
  price         Float
  assetId       String
  marketName    String
  game          String?
  icon          String?
  hexColor      String?
  commodity     Boolean  @default(false)
  buyerTradeUrl String?

  buyerId  String
  sellerId String
  buyer    user @relation("buyer_purchases",  fields: [buyerId],  references: [id])
  seller   user @relation("seller_purchases", fields: [sellerId], references: [id])
}

