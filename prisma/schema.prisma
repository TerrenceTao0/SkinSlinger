generator client {
  provider = "prisma-client"
  output = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id String @id @default(cuid())
  email String? @unique
  emailVerified DateTime?
  name String?
  image String?
  password String?
  username String? @unique
  createdAt DateTime @default(now())
  steam_trade_url String?
  steam_id String?
  steamApiKey String?
  cash Float @default(0)
  twoFactorCode String?
  twoFactorExpires DateTime?
  lastInventoryRefresh DateTime?
  inventoryCache Json?

  accounts account[]
  sessions session[]
  listings item_listing[]
  purchases_as_buyer purchase[] @relation("buyer_purchases")
  purchases_as_seller purchase[] @relation("seller_purchases")
  buy_orders buy_order[]
}

model account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model pendingAccount {
  id String @id @default(cuid())
  email String @unique
  username String @unique
  password String
  token String @unique
  expires DateTime
}

model resetPassword {
  id String @id @default(cuid())
  token String @unique
  email String @unique
  expires DateTime
}

model session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model verificationToken {
  identifier String
  token String @unique
  expires DateTime

  @@unique([identifier, token])
}

model crypto_deposit {
  id String @id @default(cuid())
  userId String
  address String @unique
  index Int @unique
  amountUsdc Float
  status String @default("pending")
  txHash String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model deposit_counter {
  id String @id
  value Int @default(0)
  lastBlock BigInt @default(0)
}

model item {
  marketName String @id
  marketHashName String
  price Float
  game String
  updatedAt DateTime @default(now()) @updatedAt
}

model item_float {
  assetId String @id
  floatValue Float?
  paintSeed Int?
  stickers Json?
  fetchedAt DateTime @default(now())
}

model item_listing {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  userId String
  assetId String @unique
  marketName String
  price Float
  game String?
  icon String?
  hexColor String?
  commodity Boolean @default(false)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model buy_order {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  userId String
  marketName String
  price Float
  quantity Int
  game String?
  icon String?
  hexColor String?

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model purchase {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  status String @default("pending")
  price Float
  assetId String
  marketName String
  game String?
  icon String?
  hexColor String?
  commodity Boolean @default(false)
  buyerTradeUrl String?

  buyerId String
  sellerId String

  buyer user @relation("buyer_purchases", fields: [buyerId], references: [id])
  seller user @relation("seller_purchases", fields: [sellerId], references: [id])
}