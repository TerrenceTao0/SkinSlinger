{
  "manifest_version": 3,
  "name": "SkinSlinger Trade Helper",
  "version": "1.0.0",
  "description": "Automatically adds the items you owe a buyer to a Steam trade offer. You still review and click Make Offer yourself.",
  "permissions": [],
  "host_permissions": [
    "https://skinslinger.com/api/extension/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://steamcommunity.com/tradeoffer/new/*"],
      "js": ["page-world.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://steamcommunity.com/tradeoffer/new/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
